__pycache__/
build*.html
build*.mcfunction
build*.schem
# NOTE: bare `scratch/` + `notes/` also exclude their contents from
# re-inclusion, so these ignore CONTENTS (trailing *) and un-ignore the
# load-bearing files by name below. Tracked-before files stay tracked.
scratch/*
.snapshots/
cand_*.txt
notes/*

